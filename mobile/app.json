{
  "expo": {
    "name": "BayLayer Labs",
    "slug": "baylayer-labs-mobile",
    "description": "Shop personalized gifts and practical 3D prints, or request a server-verified STL estimate from BayLayer Labs.",
    "version": "1.1.0",
    "backgroundColor": "#F5F8FF",
    "primaryColor": "#0C1B33",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "baylayer",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.baylayerlabs.mobile",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.baylayerlabs.mobile",
      "versionCode": 1,
      "backgroundColor": "#F5F8FF",
      "userInterfaceStyle": "light",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0C1B33",
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome-v2.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1B33",
          "image": "./assets/images/icon.png",
          "imageWidth": 128
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
