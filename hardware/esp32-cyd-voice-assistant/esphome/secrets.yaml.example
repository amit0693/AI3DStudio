# Copy to secrets.yaml (gitignored) in this same directory and fill in real values.
# secrets.yaml is shared across both cyd-dashboard.yaml and voice-satellite.yaml.

wifi_ssid: "YourWifiName"
wifi_password: "YourWifiPassword"

# Generate with: python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: ""

ota_password: "choose-a-long-random-string"
